                  padding: "10px 16px", borderBottom: "1px solid #1e2d47",
                  fontSize: 10, color: "#4a5568", textTransform: "uppercase", letterSpacing: "0.07em",
                }}>
                  <span>Rule Name</span><span>Category</span><span>Pattern</span><span>Action</span><span>Enabled</span>
                </div>
                {rules.map((r, i) => (
                  <div key={r.name} style={{
                    display: "grid", gridTemplateColumns: "1fr 80px 220px 100px 60px",
                    padding: "13px 16px", borderBottom: i < rules.length - 1 ? "1px solid #131d33" : "none",
                    alignItems: "center",
                  }}>
                    <span style={{ fontSize: 12, color: r.enabled ? "#e8edf5" : "#4a5568" }}>{r.name}</span>
                    <Badge bg="#1a2035" color="#8892a4">{r.category}</Badge>
                    <code style={{ fontSize: 10, color: "#a78bfa", background: "#080f1e", padding: "2px 6px", borderRadius: 3, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", display: "block", maxWidth: 200 }}>
                      {r.pattern.slice(0, 30)}...
                    </code>
                    <span style={{ fontSize: 11, color: { Redact: "#ff3b30", Hash: "#a78bfa", "Partially Redact": "#ff9500", Mask: "#38bdf8" }[r.action] || "#c8d0dd" }}>
                      {r.action}
                    </span>
                    <div onClick={() => toggleRule(r.name)} style={{
                      width: 32, height: 18, borderRadius: 9, cursor: "pointer",
                      background: r.enabled ? "rgba(0,212,170,0.3)" : "#1e2d47",
                      border: `1px solid ${r.enabled ? "#00d4aa" : "#2a3d5a"}`,
                      position: "relative", transition: "all 0.2s",
                    }}>
                      <div style={{
                        position: "absolute", top: 2, left: r.enabled ? 15 : 2,
                        width: 12, height: 12, borderRadius: "50%",
                        background: r.enabled ? "#00d4aa" : "#4a5568",
                        transition: "left 0.2s",
                      }} />
                    </div>
                  </div>
                ))}
              </div>

              {/* Regex tester */}
              <div style={{ marginTop: 20, background: "#0d1526", border: "1px solid #1e2d47", borderRadius: 8, padding: "20px" }}>
                <div style={{ fontSize: 12, color: "#00d4aa", marginBottom: 12, textTransform: "uppercase", letterSpacing: "0.05em" }}>⌥ Pattern Tester</div>
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                  <div>
                    <div style={{ fontSize: 10, color: "#4a5568", marginBottom: 6 }}>REGEX PATTERN</div>
                    <div style={{ background: "#080f1e", border: "1px solid #1e2d47", borderRadius: 4, padding: "8px 12px", fontSize: 12, color: "#a78bfa", fontFamily: "'IBM Plex Mono', monospace" }}>
                      \b\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}\b
                    </div>
                  </div>
                  <div>
                    <div style={{ fontSize: 10, color: "#4a5568", marginBottom: 6 }}>TEST INPUT</div>
                    <div style={{ background: "#080f1e", border: "1px solid #1e2d47", borderRadius: 4, padding: "8px 12px", fontSize: 12, color: "#c8d0dd" }}>
                      user card: <span style={{ background: "rgba(255,59,48,0.2)", color: "#ff8a85", borderRadius: 2, padding: "0 2px" }}>4111 1111 1111 1111</span> exp 12/26
                    </div>
                  </div>
                </div>
                <div style={{ marginTop: 10, fontSize: 11, color: "#00d4aa" }}>✓ 1 match found · action: Redact → [REDACTED]</div>
              </div>
            </div>
          )}

          {activeNav === "setup" && (
            <div>
              <div style={{ fontSize: 18, fontFamily: "'Syne', sans-serif", fontWeight: 700, color: "#e8edf5", marginBottom: 20 }}>Setup & Configuration</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 16 }}>
                {[
                  { icon: "☁", title: "In The Cloud", desc: "Submit logs and events to the Subzteveø backend. Data is scanned and redacted during processing before indexing.", status: "active", color: "#00d4aa" },
                  { icon: "⬡", title: "In Your Environment", desc: "Use Observability Pipelines to redact sensitive data before it leaves your premises. Add the SDS processor to your pipeline.", status: "not configured", color: "#8892a4" },
                  { icon: "⊙", title: "LLM Observability", desc: "Scan inputs and outputs from LLM applications, including prompts, completions, and workflow metadata.", status: "preview", color: "#a78bfa" },
                  { icon: "◉", title: "Cloud Storage (S3)", desc: "Catalog and classify sensitive data in Amazon S3 buckets. Deploy agentless scanners in your cloud environment.", status: "preview", color: "#fb923c" },
                ].map(item => (
                  <div key={item.title} style={{ background: "#0d1526", border: "1px solid #1e2d47", borderRadius: 8, padding: "20px" }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 10 }}>
                      <div style={{ fontSize: 24, color: item.color }}>{item.icon}</div>
                      <Badge bg={`${item.color}18`} color={item.color}>{item.status}</Badge>
                    </div>
                    <div style={{ fontSize: 14, color: "#e8edf5", fontFamily: "'Syne', sans-serif", fontWeight: 700, marginBottom: 8 }}>{item.title}</div>
                    <div style={{ fontSize: 11, color: "#8892a4", lineHeight: 1.6 }}>{item.desc}</div>
                    <div style={{ marginTop: 14, fontSize: 11, color: item.color, cursor: "pointer" }}>Configure →</div>
                  </div>
                ))}
              </div>

              {/* Sampling config */}
              <div style={{ marginTop: 16, background: "#0d1526", border: "1px solid #1e2d47", borderRadius: 8, padding: "20px" }}>
                <div style={{ fontSize: 12, color: "#e8edf5", marginBottom: 4, fontFamily: "'Syne', sans-serif", fontWeight: 700 }}>Sampling Rates</div>
                <div style={{ fontSize: 11, color: "#8892a4", marginBottom: 16 }}>Set between 10%–99% per product to manage scan costs.</div>
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: 12 }}>
                  {[{ label: "Logs", val: 78, color: "#00d4aa" }, { label: "APM", val: 45, color: "#a78bfa" }, { label: "RUM", val: 62, color: "#38bdf8" }, { label: "Events", val: 33, color: "#fb923c" }].map(item => (
                    <div key={item.label} style={{ background: "#080f1e", borderRadius: 6, padding: "14px" }}>
                      <div style={{ fontSize: 10, color: "#4a5568", marginBottom: 8 }}>{item.label}</div>
                      <div style={{ fontSize: 24, fontWeight: 700, color: item.color, fontFamily: "'Syne', sans-serif" }}>{item.val}%</div>
                      <div style={{ marginTop: 8, background: "#1a2035", borderRadius: 2, height: 3 }}>
                        <div style={{ background: item.color, width: `${item.val}%`, height: "100%", borderRadius: 2 }} />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* Fallback for other nav items */}
          {!["findings", "rules", "setup"].includes(activeNav) && (
            <div style={{ display: "flex", alignItems: "center", justifyContent: "center", height: "60%", flexDirection: "column", gap: 12 }}>
              <div style={{ fontSize: 40, color: "#1e2d47" }}>⬡</div>
              <div style={{ fontSize: 14, color: "#4a5568" }}>Navigate to Sensitive Data Scanner to begin</div>
              <div onClick={() => handleNavChange("findings")} style={{ marginTop: 8, padding: "6px 16px", background: "rgba(0,212,170,0.1)", border: "1px solid rgba(0,212,170,0.3)", color: "#00d4aa", borderRadius: 4, fontSize: 12, cursor: "pointer" }}>
                Open Findings →
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

