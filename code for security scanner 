      color: color || "#fff", background: bg || "#1a2035", textTransform: "uppercase",
    }}>{children}</span>
  );
}

function StatCard({ label, value, sub, accent }) {
  return (
    <div style={{
      background: "#0d1526", border: "1px solid #1e2d47", borderRadius: 8, padding: "18px 20px",
      flex: 1, minWidth: 120,
