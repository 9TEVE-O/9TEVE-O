      <div style={{ fontSize: 28, fontWeight: 700, color: accent || "#e8edf5", fontFamily: "'Syne', sans-serif", lineHeight: 1 }}>{value}</div>
      {sub && <div style={{ fontSize: 11, color: "#8892a4", marginTop: 6, fontFamily: "'IBM Plex Mono', monospace" }}>{sub}</div>}
    </div>
  );
}

