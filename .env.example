# Environment variables for able-to-answer
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# Path to the SQLite database file used by the application.
# Use an absolute path in production deployments.
ATA_DB_PATH=able_to_answer.sqlite3

# Maximum number of characters per text chunk during ingestion.
ATA_CHUNK_SIZE_CHARS=1200

# Overlap in characters between consecutive chunks.
# IMPORTANT: Must be strictly less than ATA_CHUNK_SIZE_CHARS or ingestion may hang in an infinite loop.
ATA_CHUNK_OVERLAP_CHARS=200

# Maximum number of chunks to include in the retrieval context per query.
ATA_MAX_CONTEXT_CHUNKS=6

# Maximum number of characters in the extractive answer returned to the caller.
ATA_MAX_ANSWER_CHARS=1800

# Optional GitHub Personal Access Token for the skill-search feature.
# Without a token, requests are unauthenticated (10 req/min rate limit).
# With a token, the limit is 30 req/min (search API).
# Grant only read:public_repo scope — no write permissions needed.
ATA_GITHUB_TOKEN=
